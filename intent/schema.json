{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docudis intent v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": ["*", "PERSON", "EMAIL", "PHONE", "ID", "NUMBER", "CARD", "IBAN", "DATE", "BIRTH_DATE", "AMOUNT", "IP", "URL", "ADDRESS", "COMPANY", "SECRET", "API_KEY"]
      },
      "additionalProperties": { "enum": ["hide", "keep", "off"] }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["at", "be", "ch", "cn", "de", "dk", "es", "fi", "fr", "gb", "ie", "it", "jp", "nl", "no", "pl", "pt", "se", "us"] }
    },
    "verticals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["healthcare", "legal", "finance", "employment", "insurance", "technology", "utilities"] }
    },
    "dictionary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "never_hide": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unsupported": { "const": true }
  }
}
