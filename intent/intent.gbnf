string ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" ( ["\\/bfnrt] | "u" [0-9a-fA-F]{4} ) )* "\""
action ::= "\"hide\"" | "\"keep\"" | "\"off\""
type0 ::= "\"*\"" ":" action
type1 ::= "\"PERSON\"" ":" action
type2 ::= "\"EMAIL\"" ":" action
type3 ::= "\"PHONE\"" ":" action
type4 ::= "\"ID\"" ":" action
type5 ::= "\"NUMBER\"" ":" action
type6 ::= "\"CARD\"" ":" action
type7 ::= "\"IBAN\"" ":" action
type8 ::= "\"DATE\"" ":" action
type9 ::= "\"BIRTH_DATE\"" ":" action
type10 ::= "\"AMOUNT\"" ":" action
type11 ::= "\"IP\"" ":" action
type12 ::= "\"URL\"" ":" action
type13 ::= "\"ADDRESS\"" ":" action
type14 ::= "\"COMPANY\"" ":" action
type15 ::= "\"SECRET\"" ":" action
type16 ::= "\"API_KEY\"" ":" action
types ::= "{" ( ( type0 | type1 | type2 | type3 | type4 | type5 | type6 | type7 | type8 | type9 | type10 | type11 | type12 | type13 | type14 | type15 | type16 ) ( "," ( type0 | type1 | type2 | type3 | type4 | type5 | type6 | type7 | type8 | type9 | type10 | type11 | type12 | type13 | type14 | type15 | type16 ) )* )? "}"
f-types ::= "\"types\"" ":" types
f-regions ::= "\"regions\"" ":" "[" ( ( "\"at\"" | "\"be\"" | "\"ch\"" | "\"cn\"" | "\"de\"" | "\"dk\"" | "\"es\"" | "\"fi\"" | "\"fr\"" | "\"gb\"" | "\"ie\"" | "\"it\"" | "\"jp\"" | "\"nl\"" | "\"no\"" | "\"pl\"" | "\"pt\"" | "\"se\"" | "\"us\"" ) ( "," ( "\"at\"" | "\"be\"" | "\"ch\"" | "\"cn\"" | "\"de\"" | "\"dk\"" | "\"es\"" | "\"fi\"" | "\"fr\"" | "\"gb\"" | "\"ie\"" | "\"it\"" | "\"jp\"" | "\"nl\"" | "\"no\"" | "\"pl\"" | "\"pt\"" | "\"se\"" | "\"us\"" ) )* )? "]"
f-verticals ::= "\"verticals\"" ":" "[" ( ( "\"healthcare\"" | "\"legal\"" | "\"finance\"" | "\"employment\"" | "\"insurance\"" | "\"technology\"" | "\"utilities\"" ) ( "," ( "\"healthcare\"" | "\"legal\"" | "\"finance\"" | "\"employment\"" | "\"insurance\"" | "\"technology\"" | "\"utilities\"" ) )* )? "]"
f-dictionary ::= "\"dictionary\"" ":" "[" ( string ( "," string )* )? "]"
f-never-hide ::= "\"never_hide\"" ":" "[" ( string ( "," string )* )? "]"
f-unsupported ::= "\"unsupported\"" ":" ( "true" | "false" )
root ::= "{" ( ( f-types | f-regions | f-verticals | f-dictionary | f-never-hide | f-unsupported ) ( "," ( f-types | f-regions | f-verticals | f-dictionary | f-never-hide | f-unsupported ) )* )? "}"
